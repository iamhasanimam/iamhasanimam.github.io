   "id": "refresh",
   "label": "Topology Refresh",
   "tech": "Lettuce adaptive refresh",
   "icon": null,
   "layer": 2,
   "col": 2,
   "row": 0,
   "says": "Adaptive refresh follows failover.",
   "detail": "MOVED, ASK and reconnect triggers reload the slot map without an app restart."
  },
