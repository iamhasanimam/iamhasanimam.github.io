   "id": "slots",
   "label": "Hash Slots",
   "tech": "CRC16 mod 16384",
   "icon": null,
   "layer": 1,
   "col": 0,
   "row": 0,
   "says": "CRC16 mod 16384 picks the slot.",
   "detail": "Each key maps to one of 16384 slots. Hash tags keep related keys together."
  },
  {
   "id": "master",
   "label": "Master",
   "tech": "Redis 7.2",
   "icon": "redis",
   "layer": 1,
   "col": 1,
   "row": 0,
   "says": "Masters own slots and serve writes.",
   "detail": "Three masters give a majority. Alternatives: Memcached for cache only, Sentinel without sharding, Valkey.",
