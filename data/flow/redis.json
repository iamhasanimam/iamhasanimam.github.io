   "icon": "redis",
   "layer": 2,
   "col": 0,
   "row": 0,
   "says": "Lettuce routes by hash slot.",
   "detail": "Cluster-aware clients such as Lettuce keep a slot map. Alternatives: Jedis, redis-py."
  },
