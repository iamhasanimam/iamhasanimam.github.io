  {
   "id": "replica",
   "label": "Replica",
   "tech": "Redis 7.2",
   "icon": "redis",
   "layer": 1,
   "col": 2,
   "row": 0,
   "says": "Replicas wait and take over.",
   "detail": "Asynchronous copy on a different host. The best offset wins the election."
  },
  {
   "id": "bus",
   "label": "Cluster Bus",
   "tech": "Gossip, port+10000",
   "icon": null,
   "layer": 1,
   "col": 3,
   "row": 0,
   "says": "Gossip detects failed masters.",
   "detail": "Pings flow on client port plus 10000. A majority turns PFAIL into FAIL."
  },
  {
   "id": "maxmem",
   "label": "maxmemory",
   "tech": "maxmemory-policy",
   "icon": null,
   "layer": 0,
   "col": 0,
   "row": 0,
   "says": "maxmemory caps RAM.",
   "detail": "Policy acts at the cap: noeviction rejects writes, allkeys-lru evicts, volatile-lru evicts keys with TTL."
  },
  {
   "id": "rdb",
   "label": "RDB",
   "tech": "RDB snapshot",
   "icon": null,
   "layer": 0,
   "col": 1,
   "row": 0,
   "says": "RDB snapshots by fork.",
   "detail": "Compact and fast to restore. Writes since the last dump are lost."
  },
  {
   "id": "aof",
   "label": "AOF",
   "tech": "appendfsync everysec",
   "icon": null,
   "layer": 0,
   "col": 2,
   "row": 0,
   "says": "AOF logs every write.",
   "detail": "Loss is bounded to about one second. Rewritten in the background."
