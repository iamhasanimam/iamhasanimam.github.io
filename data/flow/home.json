  "boxes": [
    {
      "id": "browser",
      "label": "Browser",
      "tech": "Chrome",
      "icon": "googlechrome",
      "tone": "blue",
      "layer": 5,
      "col": 0,
      "row": 0,
      "says": "The browser starts every request.",
      "detail": "Users reach the platform from a browser. It follows redirects and carries the authorization code back to the app."
    },
    {
      "id": "haproxy",
      "label": "Load balancer",
      "tech": "HAProxy",
      "icon": "haproxy",
      "tone": "blue",
      "layer": 5,
      "col": 1,
      "row": 0,
      "says": "HAProxy balances traffic across healthy upstreams.",
      "detail": "HAProxy accepts connections at layer 4 and 7, runs health checks and forwards to the gateway.",
      "href": "#/tech/haproxy"
    },
    {
      "id": "gateway",
      "label": "Kong",
      "tech": "Kong",
      "icon": "kong",
      "tone": "blue",
      "layer": 5,
      "col": 3,
      "row": 0,
      "says": "Kong enforces API policy at the edge.",
      "detail": "Kong routes requests to services and applies plugins for authentication and rate limiting. NGINX can fill this role.",
      "href": "#/tech/kong"
    },
    {
      "id": "frontend",
      "label": "Frontend",
      "tech": "Kubernetes",
      "icon": "kubernetes",
      "tone": "blue",
      "layer": 4,
      "col": 1,
      "row": 0,
      "says": "The frontend serves the app and starts login.",
      "detail": "The frontend pod runs on Kubernetes, redirects unauthenticated users to Keycloak and exchanges the returned code for tokens.",
      "href": "#/tech/kubernetes-okd"
    },
    {
      "id": "redis",
      "label": "Session cache",
      "tech": "Redis",
      "icon": "redis",
      "tone": "green",
      "layer": 4,
      "col": 1,
      "row": 1,
      "says": "Redis stores the session.",
      "detail": "Redis holds session state in memory with sub-millisecond reads, so any frontend replica can serve the user.",
      "href": "#/tech/redis"
    },
    {
      "id": "kafka",
      "label": "Event bus",
      "tech": "Kafka",
      "icon": "apachekafka",
      "tone": "green",
      "layer": 4,
      "col": 2,
      "row": 0,
      "says": "Kafka carries order events from frontend to backend.",
      "detail": "Kafka appends events to partitioned, replicated topics. The backend consumes them at its own pace.",
      "href": "#/tech/kafka"
    },
    {
      "id": "keycloak",
      "label": "Identity",
      "tech": "Keycloak",
      "icon": "keycloak",
      "tone": "green",
      "layer": 4,
      "col": 2,
      "row": 1,
      "says": "Keycloak issues the tokens.",
      "detail": "Keycloak is the OIDC provider. Browser apps use the Authorization Code flow with PKCE, and Keycloak signs JWTs.",
      "href": "#/tech/keycloak"
    },
    {
      "id": "backend",
      "label": "Backend API",
      "tech": "Kubernetes",
      "icon": "kubernetes",
      "tone": "blue",
      "layer": 4,
      "col": 3,
      "row": 0,
      "says": "The backend validates tokens and serves the API.",
      "detail": "The backend pod checks each JWT for signature, issuer and audience, then reads and writes data.",
      "href": "#/tech/kubernetes-okd"
    },
    {
      "id": "postgres",
      "label": "PostgreSQL",
      "tech": "PostgreSQL",
      "icon": "postgresql",
      "tone": "green",
      "layer": 3,
      "col": 1,
      "row": 0,
      "says": "PostgreSQL stores durable records.",
      "detail": "PostgreSQL writes every change to a write-ahead log first, then streams it to replicas.",
      "href": "#/tech/postgresql"
    },
    {
      "id": "prometheus",
      "label": "Metrics",
      "tech": "Prometheus",
      "icon": "prometheus",
      "tone": "blue",
      "layer": 2,
      "col": 1,
      "row": 0,
      "says": "Prometheus scrapes and stores metrics.",
      "detail": "Prometheus pulls metrics from services on a schedule and keeps them in a time-series database.",
      "href": "#/tech/prometheus"
    },
    {
      "id": "grafana",
      "label": "Dashboards",
      "tech": "Grafana",
      "icon": "grafana",
      "tone": "blue",
      "layer": 2,
      "col": 4,
      "row": 0,
      "says": "Grafana draws the dashboards.",
      "detail": "Grafana queries Prometheus and charts latency, traffic, errors and saturation.",
      "href": "#/tech/grafana"
    },
    {
      "id": "nginx",
      "label": "NGINX",
      "tech": "NGINX",
      "icon": "nginx",
      "tone": "blue",
      "says": "NGINX listens on HTTP and stream.",
      "detail": "Terminates TLS, serves static files and proxies requests to the gateway over keepalive upstreams.",
      "href": "#/tech/nginx",
      "layer": 5,
      "col": 2,
      "row": 0
    },
    {
      "id": "istio",
      "label": "Mesh ingress",
      "tech": "Istio",
      "icon": "istio",
      "tone": "blue",
      "says": "Istio routes by weight, not by redeploy.",
      "detail": "The ingress gateway applies VirtualService and DestinationRule rules for canary and blue-green releases.",
      "href": "#/tech/istio",
      "layer": 4,
      "col": 0,
      "row": 0
    },
    {
      "id": "kubernetes",
      "label": "Kubernetes",
      "tech": "Kubernetes",
      "icon": "kubernetes",
      "tone": "blue",
      "says": "Kubernetes orchestrates the pods.",
      "detail": "API server, scheduler and kubelets keep the desired pods running; NetworkPolicy and HPA shape traffic and scale.",
      "href": "#/tech/kubernetes-okd",
      "layer": 4,
      "col": 0,
      "row": 1
    },
    {
      "id": "openbao",
      "label": "Vault",
      "tech": "Vault",
      "icon": "vault",
      "tone": "green",
      "says": "Vault hands out secrets.",
      "detail": "AppRole auth and policies give each workload only the secrets it needs.",
      "href": "#/tech/openbao",
      "layer": 4,
      "col": 3,
      "row": 1
    },
    {
      "id": "minio",
      "label": "MinIO",
      "tech": "MinIO",
      "icon": "minio",
      "tone": "green",
      "says": "MinIO stores objects as S3.",
      "detail": "Holds database backups and log chunks on S3-compatible storage.",
      "href": "#/tech/loki-minio",
      "layer": 3,
      "col": 2,
      "row": 0
    },
    {
      "id": "otel",
      "label": "OTel collector",
      "tech": "OpenTelemetry",
      "icon": "opentelemetry",
      "tone": "blue",
      "says": "OpenTelemetry collects telemetry.",
      "detail": "Receives traces and logs from services and pushes them to Tempo and Loki.",
      "href": "#/tech/loki-minio",
      "layer": 2,
      "col": 0,
      "row": 0
    },
    {
      "id": "loki",
      "label": "Loki",
      "tech": "Loki",
      "icon": "grafana",
      "tone": "blue",
      "says": "Loki indexes logs by label.",
      "detail": "Stores log chunks in object storage and answers LogQL queries.",
      "href": "#/tech/loki-minio",
      "layer": 2,
      "col": 2,
      "row": 0
    },
    {
      "id": "tempo",
      "label": "Tempo",
      "tech": "Tempo",
      "icon": "grafana",
      "tone": "blue",
      "says": "Tempo stores traces.",
      "detail": "Keeps distributed traces so one request can be followed across services.",
      "href": "#/tech/loki-minio",
      "layer": 2,
      "col": 3,
      "row": 0
    },
    {
      "id": "git",
      "label": "Git",
      "tech": "Git",
      "icon": "git",
      "tone": "blue",
      "says": "Git is the source of truth.",
      "detail": "Every change starts as a commit that the pipeline builds and ships.",
      "href": null,
      "layer": 1,
      "col": 0,
      "row": 0
    },
    {
      "id": "jenkins",
      "label": "Jenkins",
      "tech": "Jenkins",
      "icon": "jenkins",
      "tone": "blue",
      "says": "Jenkins builds, scans and releases.",
      "detail": "A gated pipeline builds, tests, scans and pushes images, then triggers the GitOps release.",
      "href": "#/tech/jenkins",
      "layer": 1,
      "col": 1,
      "row": 0
    },
    {
      "id": "argo",
      "label": "Argo CD",
      "tech": "Argo CD",
      "icon": "argo",
      "tone": "green",
      "says": "Argo CD syncs the cluster to Git.",
      "detail": "Pulls the desired state from Git and applies it to the cluster.",
      "href": "#/tech/jenkins",
      "layer": 1,
      "col": 2,
      "row": 0
    },
    {
      "id": "ansible",
      "label": "Ansible",
      "tech": "Ansible",
      "icon": "ansible",
      "tone": "blue",
      "says": "Ansible configures every host.",
      "detail": "Idempotent roles harden SSH, set time sync and keep nodes identical.",
      "href": "#/tech/ansible",
      "layer": 1,
      "col": 3,
      "row": 0
    },
    {
      "id": "linux",
      "label": "Linux",
      "tech": "Linux",
      "icon": "linux",
      "tone": "green",
      "says": "Linux manages cgroups, namespaces and mounts.",
      "detail": "The kernel isolates workloads and routes traffic with bridges, veth pairs and iptables.",
      "href": "#/tech/linux-networking",
      "layer": 0,
      "col": 1,
      "row": 0
    },
    {
      "id": "docker",
      "label": "Docker",
      "tech": "Docker",
      "icon": "docker",
      "tone": "blue",
      "says": "Docker packages the runtime.",
      "detail": "Images and containers run on namespaces and cgroups with memory limits.",
      "href": "#/tech/docker",
      "layer": 0,
      "col": 2,
      "row": 0
    },
    {
      "id": "vmware",
      "label": "ESXi",
      "tech": "VMware ESXi",
      "icon": "vmware",
      "tone": "green",
      "says": "ESXi virtualises the metal.",
      "detail": "Bare-metal host with a public and a private vSwitch for isolated networks.",
      "href": "#/tech/vmware-esxi",
      "layer": 0,
      "col": 3,
      "row": 0
    },
    {
      "id": "aws",
      "label": "AWS",
      "tech": "AWS",
      "icon": "amazonaws",
      "tone": "blue",
      "says": "AWS runs the cloud edge.",
      "detail": "VPC, ALB with ACM, Route 53 and SSM-only private instances.",
      "href": "#/tech/aws",
      "layer": 0,
      "col": 4,
      "row": 0
    }
