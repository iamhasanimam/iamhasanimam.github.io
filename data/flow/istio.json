  "steps": [
    {
      "title": "Inject",
      "text": "Annotate the pod template. Envoy joins the pod.",
      "boxes": [
        "sidecar",
        "istiod"
      ],
      "wires": [
        [
          "istiod",
          "sidecar"
        ]
      ]
    },
    {
      "title": "Define subsets",
      "text": "DestinationRule sets stable, canary and ringHash.",
      "boxes": [
        "dr",
        "stable",
        "canary"
      ],
      "wires": [
        [
          "dr",
          "stable"
        ],
        [
          "dr",
          "canary"
        ]
      ]
    },
    {
      "title": "Shift weights",
      "text": "VirtualService moves 90/10 to 0/100.",
      "boxes": [
        "vs",
        "dr",
        "stable",
        "canary"
      ],
      "wires": [
        [
          "vs",
          "dr"
        ],
        [
          "dr",
          "stable"
        ],
        [
          "dr",
          "canary"
        ]
      ]
    },
    {
      "title": "Lock identity",
      "text": "STRICT mTLS and AuthorizationPolicy gate callers.",
      "boxes": [
        "authz",
        "sidecar",
        "stable"
      ],
      "wires": [
        [
          "authz",
          "sidecar"
        ],
        [
          "sidecar",
          "stable"
        ]
      ]
    },
    {
      "title": "Cross clusters",
      "text": "Traffic hits 15443 and passes through by SNI.",
      "boxes": [
        "stable",
        "ewgw",
        "recv",
        "clusterb"
      ],
      "wires": [
        [
          "stable",
          "ewgw"
        ],
        [
          "ewgw",
          "recv"
        ],
        [
          "recv",
          "clusterb"
        ]
      ]
    }
  ],
  "run": {
    "cmd": "istioctl x describe pod frontend -n shop",
    "lines": [
      "Route to subset stable weight 90, canary weight 10",
      "Effective PeerAuthentication: STRICT"
    ]
  },
  "declarations": [
    "Istio routes by weight.",
    "Envoy proxies every pod.",
    "mTLS authenticates every hop.",
    "Two clusters become one mesh."
  ]
}