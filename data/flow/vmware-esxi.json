    "user",
    "vsw0",
    "gw"
   ],
   "wires": [
    [
     "user",
     "vsw0"
    ],
    [
     "vsw0",
     "gw"
    ]
   ]
  },
  {
   "title": "Translate",
   "text": "The gateway forwards 443 to the RD Gateway.",
   "boxes": [
    "gw",
    "vsw1",
    "rdgw"
   ],
   "wires": [
    [
     "gw",
     "vsw1"
    ],
    [
     "vsw1",
     "rdgw"
    ]
   ]
  },
  {
   "title": "Authenticate",
