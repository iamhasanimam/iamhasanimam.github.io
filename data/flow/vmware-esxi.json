   "detail": "The client reaches the RD Gateway name on port 443."
  },
  {
   "id": "gw",
   "label": "Gateway VM",
   "tech": "Linux dual-NIC gateway",
   "icon": "linux",
   "layer": 3,
   "col": 2,
   "row": 0,
   "says": "The gateway VM routes and NATs.",
   "detail": "One NIC on each vSwitch; MASQUERADE out, DNAT 443 in. Alternatives: pfSense, OPNsense, VyOS."
  },
  {
   "id": "rdgw",
   "label": "RD Gateway",
