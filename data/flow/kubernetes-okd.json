      "id": "ingress",
      "label": "Ingress Route",
      "tech": "Ingress / OpenShift Route",
      "icon": "kubernetes",
      "layer": 0,
      "col": 0,
      "row": 0,
      "says": "Ingress routes by Host and path.",
      "detail": "L7 entry. A controller terminates TLS and picks a Service. OKD serves Routes through HAProxy."
    },
    {
      "id": "svc",
      "label": "Service",
      "tech": "Service",
      "icon": null,
      "layer": 0,
      "col": 1,
      "row": 0,
      "says": "A Service balances at L4.",
      "detail": "ClusterIP gives pods one stable address. NodePort opens a node port. Endpoints follow readiness."
    },
    {
      "id": "netpol",
      "label": "NetworkPolicy",
      "tech": "NetworkPolicy",
      "icon": null,
      "layer": 0,
      "col": 2,
      "row": 0,
      "says": "NetworkPolicy denies by default.",
      "detail": "Selects pods, then allows by namespace and label. Needs a CNI that enforces it."
    },
    {
      "id": "pods",
      "label": "Pods",
      "tech": "Pod",
      "icon": null,
      "layer": 1,
      "col": 1,
      "row": 0,
      "says": "Pods run your containers.",
      "detail": "Requests and limits set placement and OOM behaviour. Readiness gates traffic."
    },
    {
      "id": "deploy",
      "label": "Deployment",
      "tech": "Deployment",
      "icon": null,
      "layer": 1,
      "col": 0,
      "row": 0,
      "says": "Deployments roll out and roll back.",
      "detail": "A ReplicaSet per version. maxSurge and maxUnavailable pace the rollout; rollout undo reverts."
    },
    {
      "id": "hpa",
      "label": "HPA",
      "tech": "HorizontalPodAutoscaler",
      "icon": null,
      "layer": 1,
      "col": 2,
      "row": 0,
      "says": "HPA scales replicas on metrics.",
      "detail": "Reads CPU or custom metrics and sets replicas between min and max."
    },
    {
      "id": "hpagen",
      "label": "Rule Generator",
      "tech": "HPA rule generator",
      "icon": null,
      "layer": 1,
      "col": 2,
      "row": 1,
      "says": "One rule list renders every HPA.",
      "detail": "A ConfigMap of per-service rules becomes consistent HPA manifests. Reviewable in Git."
    },
    {
      "id": "api",
      "label": "API Server",
      "tech": "Kubernetes",
      "icon": "kubernetes",
      "layer": 2,
      "col": 1,
      "row": 0,
      "says": "The API server is the front door.",
      "detail": "Authenticates, authorizes with RBAC, validates and persists to etcd. Everything else watches it.",
