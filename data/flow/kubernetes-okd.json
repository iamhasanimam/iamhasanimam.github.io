        {
          "id": "apiserver",
          "label": "API server"
        },
        {
          "id": "etcd",
          "label": "etcd"
        },
        {
          "id": "scheduler",
          "label": "Scheduler"
        },
        {
          "id": "controllers",
          "label": "Controllers"
        }
      ]
    },
    {
      "id": "rbac",
      "label": "RBAC",
      "tech": "RBAC",
      "icon": null,
      "layer": 2,
      "col": 0,
      "row": 0,
      "says": "RBAC grants least privilege.",
      "detail": "Role and RoleBinding per namespace. ClusterRole for cluster scope. Verify with auth can-i."
    },
    {
      "id": "ns",
      "label": "Namespaces",
      "tech": "Namespace",
      "icon": null,
      "layer": 0,
      "col": 3,
      "row": 0,
      "says": "Namespaces scope names and quotas.",
      "detail": "The unit for ResourceQuota, RBAC and NetworkPolicy. One per team or environment."
