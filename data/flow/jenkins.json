  },
  {
   "id": "gitops",
   "label": "GitOps Repo",
   "tech": "Git",
   "icon": "git",
   "layer": 0,
   "col": 1,
   "row": 0,
   "says": "Jenkins commits the new tag.",
   "detail": "A Kustomize overlay or Helm values file gets the new image tag."
