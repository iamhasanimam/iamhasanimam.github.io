 "steps": [
  {
   "title": "Accept",
   "text": "The balancer sends TLS and the PROXY header to Kong.",
   "boxes": [
    "client",
    "lb",
    "kong"
   ],
   "wires": [
    [
     "client",
     "lb"
    ],
    [
     "lb",
     "kong"
    ]
   ]
  },
  {
   "title": "Match",
   "text": "The router picks a Route by host, path and method.",
   "boxes": [
    "kong"
   ],
   "wires": []
  },
  {
   "title": "Enforce",
   "text": "Plugins authenticate and rate limit the request.",
   "boxes": [
    "kong"
   ],
   "wires": []
  },
  {
   "title": "Proxy",
   "text": "The balancer sends it to a healthy Target.",
   "boxes": [
    "kong",
    "app"
   ],
   "wires": [
    [
     "kong",
     "app"
    ]
   ]
  },
  {
   "title": "Ship config",
   "text": "Git, Jenkins and decK diff then sync the change.",
   "boxes": [
    "git",
    "jenkins",
    "deck",
    "kong"
   ],
   "wires": [
    [
     "git",
     "jenkins"
    ],
    [
     "jenkins",
     "deck"
    ],
    [
     "deck",
     "kong"
    ]
   ]
  }
 ],
 "run": {
  "cmd": "deck gateway diff -s kong.yaml",
  "lines": [
   "Summary: Created: 1 Updated: 1 Deleted: 0",
   "diff-guard: no deletes, safe to sync"
  ]
 },
 "declarations": [
  "Kong gates every API call.",
  "Git declares, decK syncs.",
  "The guard blocks deletes.",
  "Plugins enforce auth and limits."
 ]
}